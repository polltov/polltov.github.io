---
import '../styles/global.css';
import { LEADS_API } from '../config/api';
import { site } from '../config/site';
import { LEAD_STATUSES } from '../lib/lead-status';

const apiOrigin = new URL(LEADS_API).origin;
const csp = `default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self'; connect-src ${apiOrigin}; base-uri 'none'; form-action 'none'`;
const metricaId = site.metricaId;
const metricaDashboard = metricaId
  ? `https://metrika.yandex.ru/dashboard?id=${metricaId}`
  : '';
const leadFilters = [{ id: 'all', filter: 'Все' }, ...LEAD_STATUSES];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <link rel="preload" href="/fonts/GeneralSans-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeneralSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <title>Админка — {site.name}</title>
  </head>
  <body class="bg-cream text-ink antialiased">
    <main class="mx-auto max-w-[1280px] px-5 py-8 md:px-10 md:py-14">
      <header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <h1 class="font-display text-[clamp(1.65rem,7.5vw,3.75rem)] leading-tight">Заявки с сайта</h1>
        <div id="admin-actions" hidden class="flex min-w-0 flex-wrap items-center gap-2 text-sm text-ink/70 lg:justify-end">
          <span id="admin-user-label" class="basis-full [overflow-wrap:anywhere] sm:basis-auto sm:pr-2"></span>
          <button type="button" id="btn-refresh" class="btn-outline px-3.5">Обновить</button>
          <button type="button" id="btn-export" class="btn-outline px-3.5">Скачать CSV</button>
          <button type="button" id="btn-logout" class="btn-outline px-3.5">Выйти</button>
        </div>
      </header>

      <!-- Login -->
      <section id="login-card" class="mt-10 max-w-md rounded-[24px] border border-ink bg-cream-warm p-6 md:p-8">
        <h2 class="font-display text-2xl leading-tight md:text-3xl">Войти в админку</h2>
        <form id="login-form" method="post" class="mt-6 space-y-4">
          <label class="block">
            <span class="label text-ink/70">Логин</span>
            <input
              name="user"
              type="text"
              maxlength="200"
              autocomplete="username"
              required
              class="mt-2 w-full rounded-xl border border-ink bg-transparent px-4 py-3 text-base text-ink placeholder:text-ink/40 focus:outline-none focus:ring-2 focus:ring-ink"
            />
          </label>
          <label class="block">
            <span class="label text-ink/70">Пароль</span>
            <input
              name="pass"
              type="password"
              maxlength="1024"
              autocomplete="current-password"
              required
              class="mt-2 w-full rounded-xl border border-ink bg-transparent px-4 py-3 text-base text-ink placeholder:text-ink/40 focus:outline-none focus:ring-2 focus:ring-ink"
            />
          </label>
          <label class="flex items-center gap-2 text-sm text-ink/80">
            <input id="remember" type="checkbox" checked class="h-4 w-4 accent-ink" />
            Оставаться в системе при обновлении страницы
          </label>
          <div class="flex flex-wrap items-center gap-3">
            <button id="btn-login" type="submit" class="btn-ink">Войти</button>
            <p id="login-status" class="text-sm text-ink/70" role="status"></p>
          </div>
        </form>
      </section>

      <!-- Leads view -->
      <section id="leads-card" class="mt-8 md:mt-10" hidden aria-label="Заявки">
        <!-- KPI cards (lead-based; site traffic is in Metrica) -->
        <div class="mb-6 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
          <div class="rounded-[20px] border border-ink bg-lime p-4 md:p-5">
            <p class="label text-ink/70">Всего заявок</p>
            <p id="kpi-total" class="mt-2 font-display text-3xl leading-none md:text-4xl">0</p>
          </div>
          <div class="rounded-[20px] border border-ink bg-violet p-4 md:p-5">
            <p class="label text-ink/70">За 7 дней</p>
            <p id="kpi-week" class="mt-2 font-display text-3xl leading-none md:text-4xl">0</p>
          </div>
          <div class="rounded-[20px] border border-ink bg-cream-warm p-4 md:p-5">
            <p class="label text-ink/70">Сегодня</p>
            <p id="kpi-today" class="mt-2 font-display text-3xl leading-none md:text-4xl">0</p>
          </div>
          <div class="rounded-[20px] border border-ink bg-ink p-4 text-cream md:p-5">
            <p class="label text-cream/70">Топ услуга</p>
            <p id="kpi-top" class="mt-2 font-display text-base leading-tight [overflow-wrap:anywhere] [hyphens:auto] md:text-lg xl:text-xl">—</p>
          </div>
        </div>

        {metricaId ? (
          <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-[20px] border border-ink bg-cream-warm p-4 md:p-5">
            <div>
              <p class="label text-ink/60">Посещения, источники, карты</p>
              <p class="mt-1 text-sm text-ink/80">Полная аналитика сайта в Яндекс.Метрике</p>
            </div>
            <a
              href={metricaDashboard}
              target="_blank"
              rel="noopener"
              class="btn-ink"
            >
              Открыть Метрику
            </a>
          </div>
        ) : (
          <div class="mb-6 rounded-[20px] border border-dashed border-ink/40 p-4 text-sm text-ink/60 md:p-5">
            Счётчик Яндекс.Метрики ещё не подключён — дай ID в <code class="font-mono">site.metricaId</code>, и блок станет активным.
          </div>
        )}

        <div id="lead-status-filters" role="group" aria-label="Фильтр по статусу" class="mb-4 flex flex-wrap gap-2" hidden>
          {leadFilters.map(({ id, filter }) => (
            <button type="button" class="lead-status-filter" data-status-filter={id} data-lead-tone={id} aria-pressed={id === 'all' ? 'true' : 'false'}>
              {id !== 'all' && <span class="lead-status-dot" aria-hidden="true"></span>}
              {filter}
              <span class="lead-status-count" data-status-count>0</span>
            </button>
          ))}
        </div>

        <div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-ink/70">
          <p id="leads-count"></p>
          <label for="leads-filter" class="sr-only">Поиск заявок</label>
          <input
            id="leads-filter"
            type="search"
            placeholder="Имя, телефон или услуга"
            class="w-full rounded-xl border border-ink bg-transparent px-4 py-2.5 text-base text-ink placeholder:text-ink/65 focus:outline-none focus:ring-2 focus:ring-ink sm:ml-auto sm:max-w-sm"
          />
        </div>

        <p id="leads-status" class="mb-3 text-sm text-ink/70 empty:mb-0" role="status"></p>

        <div id="leads-list" hidden class="overflow-hidden rounded-[20px] border border-ink">
          <table id="leads-table" role="table" aria-label="Список заявок" class="w-full text-left text-sm md:text-base">
            <thead role="rowgroup" class="bg-ink text-cream">
              <tr role="row">
                <th scope="col" role="columnheader" class="px-4 py-3 font-medium">Дата</th>
                <th scope="col" role="columnheader" class="px-4 py-3 font-medium">Имя</th>
                <th scope="col" role="columnheader" class="px-4 py-3 font-medium">Телефон</th>
                <th scope="col" role="columnheader" class="px-4 py-3 font-medium">Тип ролика</th>
                <th scope="col" role="columnheader" class="px-4 py-3 font-medium">Статус</th>
                <th scope="col" role="columnheader" class="px-4 py-3 font-medium">IP</th>
                <th scope="col" role="columnheader" class="px-4 py-3 text-right font-medium">Действия</th>
              </tr>
            </thead>
            <tbody id="leads-tbody" role="rowgroup" class="divide-y divide-ink/15"></tbody>
          </table>
        </div>

        <p id="leads-empty" hidden class="mt-6 rounded-[20px] border border-ink/20 p-5 text-center text-sm text-ink/70" role="status"></p>

        <nav id="leads-pagination" hidden aria-label="Страницы заявок" class="mt-4 flex flex-wrap items-center justify-between gap-3">
          <button type="button" id="leads-prev" class="btn-outline px-3.5">Назад</button>
          <p id="leads-page" class="order-first basis-full text-sm text-ink/70 sm:order-0 sm:basis-auto" aria-live="polite"></p>
          <button type="button" id="leads-next" class="btn-outline px-3.5">Дальше</button>
        </nav>
      </section>
    </main>

    <script>
      import '../scripts/admin';
    </script>
  </body>
</html>

<style>
  #leads-card :global([data-lead-tone="new"]) { --lead-tone: #506915; }
  #leads-card :global([data-lead-tone="in_progress"]) { --lead-tone: #5740a5; }
  #leads-card :global([data-lead-tone="rejected"]) { --lead-tone: #a12b3a; }
  #leads-card :global([data-lead-tone="closed"]) { --lead-tone: #38614b; }

  .lead-status-filter {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
    border-radius: 999px;
    background: var(--color-cream);
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }

  .lead-status-filter:hover {
    border-color: var(--color-ink);
  }

  .lead-status-filter[aria-pressed="true"] {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-cream);
  }

  .lead-status-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--lead-tone);
  }

  .lead-status-filter[aria-pressed="true"] .lead-status-dot {
    background: color-mix(in srgb, var(--lead-tone) 55%, white);
  }

  .lead-status-count {
    color: color-mix(in srgb, currentColor 85%, transparent);
    font-variant-numeric: tabular-nums;
  }

  #leads-table :global(.lead-status-select) {
    max-width: 100%;
    min-height: 44px;
    padding: 0.4rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--lead-tone) 55%, var(--color-cream));
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--lead-tone) 10%, var(--color-cream));
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 500;
  }

  #leads-table :global(td) {
    padding: 0.55rem 1rem;
    overflow-wrap: anywhere;
  }

  #leads-table :global(.lead-cell-label) {
    display: none;
  }

  button:disabled,
  #leads-table :global(button:disabled),
  #leads-table :global(select:disabled) {
    cursor: default;
    opacity: 0.5;
  }

  @media (max-width: 767px) {
    #admin-actions .btn-outline {
      min-height: 44px;
      padding-inline: 0.7rem;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
    }

    #leads-table,
    #leads-table tbody,
    #leads-table :global(tr) {
      display: block;
    }

    #leads-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    #leads-table :global(tbody tr) {
      padding: 0.75rem 1rem;
    }

    #leads-table :global(td) {
      display: grid;
      grid-template-columns: minmax(4.25rem, 28%) minmax(0, 1fr);
      align-items: center;
      gap: 0.75rem;
      padding: 0.3rem 0;
    }

    #leads-table :global(.lead-cell-label) {
      display: block;
      color: color-mix(in srgb, var(--color-ink) 70%, transparent);
      font-size: 0.75rem;
      font-weight: 400;
    }

    #leads-table :global(.lead-delete),
    #leads-table :global(.lead-status-select) {
      justify-self: start;
    }
  }
</style>
